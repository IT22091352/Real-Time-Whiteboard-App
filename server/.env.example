# Server Configuration
PORT=4000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here

# Database Configuration (PostgreSQL for Production, SQLite for Local Dev)
DATABASE_URL="postgresql://user:password@localhost:5432/whiteboard_db?schema=public"

# Redis Configuration (Optional for socket scaling across multiple instances)
REDIS_URL="redis://localhost:6379"

# Client CORS & URL Configuration
CLIENT_URL="https://your-whiteboard-app.vercel.app"
CLIENT_ORIGIN="https://your-whiteboard-app.vercel.app"

# AI Assistant Integration
AI_API_KEY="your_ai_api_key_here"
AI_MODEL="gemini-2.5-flash"

# Cloud Asset Storage Configuration (AWS S3 / Cloudflare R2)
STORAGE_URL="https://your-bucket-name.s3.us-east-1.amazonaws.com"
STORAGE_ACCESS_KEY="your_storage_access_key"
STORAGE_SECRET_KEY="your_storage_secret_key"
STORAGE_BUCKET="your_storage_bucket_name"
